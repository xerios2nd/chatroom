{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "checkJs": false,
    "allowJs": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "tests/**/*.js"]
}
