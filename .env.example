# Where the Vite dev/preview proxy forwards /unsloth/* requests.
# `unsloth run ...` serves its OpenAI-compatible API on port 8888 by default.
UNSLOTH_TARGET=http://localhost:8888

# Optional: an OpenAI-compatible speech server for voice mode (/v1/audio/transcriptions, /v1/audio/speech),
# e.g. Speaches, whisper.cpp server or Kokoro-FastAPI. Set Settings → Voice → Base URL to /speech/v1 to use it.
# SPEECH_TARGET=http://localhost:8000
